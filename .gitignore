# .gitignore for Parkinson's Disease Prediction System

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
.venv-nb/
venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints
notebooks/*-executed.ipynb
# Downloaded notebook demo media (see notebooks/README.md)
notebooks/sample/**
notebooks/samples/**
*/.ipynb_checkpoints/*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Data
# Ignore processed/generated data (can be recreated)
data/processed/
data/raw/gait/*.csv
# Large raw downloads (regenerate via data/raw/*/download_*_sources.sh)
data/raw/handwriting/uci_spiral/
data/raw/handwriting/kaggle_spiral/
data/raw/gait/kaggle_mirror/

# Allow speech dataset to be committed (needed for Docker builds)
!data/raw/speech/parkinsons.csv
!data/raw/speech/parkinsons_telemonitoring.csv

# Voice pipeline reports (regenerate: python scripts/train_voice_pipeline.py)
reports/voice_metrics.json
reports/voice_test_predictions.npz

# Models
models/*.joblib
models/*.pkl
models/*.h5
models/*.pt
models/*.png
models/*.csv
models/*.json
!models/.gitkeep

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Documentation build
docs/_build/

# OS
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.bak
*.swp
temp/
tmp/

